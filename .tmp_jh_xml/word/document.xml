<?xml version="1.0" encoding="UTF-8" standalone="yes"?><w:document mc:Ignorable="w14 w15 wp14" xmlns:wpc="http://schemas.microsoft.com/office/word/2010/wordprocessingCanvas" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:m="http://schemas.openxmlformats.org/officeDocument/2006/math" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:wp14="http://schemas.microsoft.com/office/word/2010/wordprocessingDrawing" xmlns:wp="http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing" xmlns:w10="urn:schemas-microsoft-com:office:word" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:w14="http://schemas.microsoft.com/office/word/2010/wordml" xmlns:w15="http://schemas.microsoft.com/office/word/2012/wordml" xmlns:wpg="http://schemas.microsoft.com/office/word/2010/wordprocessingGroup" xmlns:wpi="http://schemas.microsoft.com/office/word/2010/wordprocessingInk" xmlns:wne="http://schemas.microsoft.com/office/word/2006/wordml" xmlns:wps="http://schemas.microsoft.com/office/word/2010/wordprocessingShape" xmlns:cx="http://schemas.microsoft.com/office/drawing/2014/chartex" xmlns:cx1="http://schemas.microsoft.com/office/drawing/2015/9/8/chartex" xmlns:cx2="http://schemas.microsoft.com/office/drawing/2015/10/21/chartex" xmlns:cx3="http://schemas.microsoft.com/office/drawing/2016/5/9/chartex" xmlns:cx4="http://schemas.microsoft.com/office/drawing/2016/5/10/chartex" xmlns:cx5="http://schemas.microsoft.com/office/drawing/2016/5/11/chartex" xmlns:cx6="http://schemas.microsoft.com/office/drawing/2016/5/12/chartex" xmlns:cx7="http://schemas.microsoft.com/office/drawing/2016/5/13/chartex" xmlns:cx8="http://schemas.microsoft.com/office/drawing/2016/5/14/chartex" xmlns:aink="http://schemas.microsoft.com/office/drawing/2016/ink" xmlns:am3d="http://schemas.microsoft.com/office/drawing/2017/model3d" xmlns:w16cex="http://schemas.microsoft.com/office/word/2018/wordml/cex" xmlns:w16cid="http://schemas.microsoft.com/office/word/2016/wordml/cid" xmlns:w16="http://schemas.microsoft.com/office/word/2018/wordml" xmlns:w16sdtdh="http://schemas.microsoft.com/office/word/2020/wordml/sdtdatahash" xmlns:w16se="http://schemas.microsoft.com/office/word/2015/wordml/symex"><w:body><w:p><w:pPr><w:spacing w:after="80"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:color w:val="1F3864"/><w:sz w:val="34"/><w:szCs w:val="34"/></w:rPr><w:t xml:space="preserve">에이전트 확장 방안</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="180"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:color w:val="2E74B5"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">고객의 말 속 숨은 수요를 마케팅 자원으로 활용하기</w:t></w:r></w:p><w:p><w:pPr><w:pBdr><w:bottom w:val="single" w:color="1F3864" w:sz="10" w:space="6"/></w:pBdr><w:spacing w:after="60"/></w:pPr><w:r><w:rPr><w:color w:val="262626"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t xml:space="preserve">고객 문의(VoC)를 여러 AI 에이전트가 나눠 분석해서 기획전·기획 상품을 제안한다.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/><w:pBdr><w:bottom w:val="single" w:color="2E74B5" w:sz="8" w:space="4"/></w:pBdr><w:spacing w:after="120" w:before="320"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:color w:val="1F3864"/><w:sz w:val="27"/><w:szCs w:val="27"/></w:rPr><w:t xml:space="preserve">트랙 C. 기획전·기획 상품 제안</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="100"/></w:pPr><w:r><w:rPr><w:color w:val="262626"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t xml:space="preserve">많은 판매 상품 중 어떤 상품을 메인 화면에 노출할지 정하는 것은 매출에 직접적인 영향을 미칩니다. 이 트랙은 고객 문의 데이터를 바탕으로 “지금 메인에 무엇을 보여줘야 할지”를 데이터 기반으로 제안하는 기능입니다.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="80" w:before="200"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:color w:val="2E74B5"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">구성 에이전트</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="100"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:color w:val="2E74B5"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t xml:space="preserve">①  </w:t></w:r><w:r><w:rPr><w:b/><w:bCs/><w:color w:val="262626"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t xml:space="preserve">관심사 추출 에이전트</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="100"/></w:pPr><w:r><w:rPr><w:color w:val="262626"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t xml:space="preserve">문의 속에서 고객들이 자주 찾는 상품, 스타일, 키워드를 뽑아냅니다.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:after="50"/></w:pPr><w:r><w:rPr><w:color w:val="262626"/><w:sz w:val="19"/><w:szCs w:val="19"/></w:rPr><w:t xml:space="preserve">네이버 데이터랩(datalab.naver.com)의 월간·주간·일간 인기 검색어를 함께 활용해, 문의 키워드와 실제 쇼핑 트렌드를 같이 반영한 상품을 제안</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="100"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:color w:val="2E74B5"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t xml:space="preserve">②  </w:t></w:r><w:r><w:rPr><w:b/><w:bCs/><w:color w:val="262626"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t xml:space="preserve">수요 신호 종합 에이전트</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="100"/></w:pPr><w:r><w:rPr><w:color w:val="262626"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t xml:space="preserve">“OO 없나요?” 같은 문맥을 문의에서 찾아내어, 고객들이 원하지만 아직 없거나 노출이 적었던 상품·수요를 발굴합니다.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="100"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:color w:val="2E74B5"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t xml:space="preserve">③  </w:t></w:r><w:r><w:rPr><w:b/><w:bCs/><w:color w:val="262626"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t xml:space="preserve">연간 소비 패턴 감지 에이전트</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="100"/></w:pPr><w:r><w:rPr><w:color w:val="262626"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t xml:space="preserve">계절·시기별로 반복되는 문의 패턴을 감지해 다가올 수요를 미리 예측합니다.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:after="50"/></w:pPr><w:r><w:rPr><w:color w:val="262626"/><w:sz w:val="19"/><w:szCs w:val="19"/></w:rPr><w:t xml:space="preserve">예: 장마철 전 &apos;방수·제습&apos; 문의 증가 → 장마 대비 기획전 제안</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:after="50"/></w:pPr><w:r><w:rPr><w:color w:val="262626"/><w:sz w:val="19"/><w:szCs w:val="19"/></w:rPr><w:t xml:space="preserve">네이버 데이터랩의 인기 검색어 데이터를 함께 활용 가능</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="100"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:color w:val="2E74B5"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t xml:space="preserve">④  </w:t></w:r><w:r><w:rPr><w:b/><w:bCs/><w:color w:val="262626"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t xml:space="preserve">세트 상품 기획 에이전트</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="100"/></w:pPr><w:r><w:rPr><w:color w:val="262626"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t xml:space="preserve">특정 상품을 구매하거나 문의한 고객이 함께 찾는 다른 상품을 감지해 묶음 상품을 제안합니다.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:after="50"/></w:pPr><w:r><w:rPr><w:color w:val="262626"/><w:sz w:val="19"/><w:szCs w:val="19"/></w:rPr><w:t xml:space="preserve">예: “드릴 주문했는데 못은 안 파나요?” → 드릴+못 세트 상품 제안</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:after="50"/></w:pPr><w:r><w:rPr><w:color w:val="262626"/><w:sz w:val="19"/><w:szCs w:val="19"/></w:rPr><w:t xml:space="preserve">예: 그릇 구매자들이 테이블 매트도 함께 구매 → 그릇+테이블매트 세트 상품 제안</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="100"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:color w:val="2E74B5"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t xml:space="preserve">⑤  </w:t></w:r><w:r><w:rPr><w:b/><w:bCs/><w:color w:val="262626"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t xml:space="preserve">기획전 제안 에이전트</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="100"/></w:pPr><w:r><w:rPr><w:color w:val="262626"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t xml:space="preserve">위 네 에이전트가 찾아낸 정보를 종합해, &apos;이번 주 기획전 주제&apos;와 그 근거를 제안합니다.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/><w:pBdr><w:bottom w:val="single" w:color="2E74B5" w:sz="8" w:space="4"/></w:pBdr><w:spacing w:after="120" w:before="320"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:color w:val="1F3864"/><w:sz w:val="27"/><w:szCs w:val="27"/></w:rPr><w:t xml:space="preserve">트랙 D. 반품 재고 기반 리퍼브 기획전 제안</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="100"/></w:pPr><w:r><w:rPr><w:color w:val="262626"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t xml:space="preserve">이미 반품되어 쌓여 있는 재고를 어떻게 처리할지 제안하는 기능입니다. 반품 재고가 일정 기준에 도달하면 자동으로 감지해 리퍼브 기획전을 제안합니다.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="80" w:before="200"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:color w:val="2E74B5"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">구성 에이전트</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="100"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:color w:val="2E74B5"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t xml:space="preserve">①  </w:t></w:r><w:r><w:rPr><w:b/><w:bCs/><w:color w:val="262626"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t xml:space="preserve">반품 사유 분석 에이전트</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="100"/></w:pPr><w:r><w:rPr><w:color w:val="262626"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t xml:space="preserve">반품 사유(단순 변심, 사이즈 불만, 하자 등)를 분류해 재판매 가능 상품과 폐기 상품을 구분합니다.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:after="50"/></w:pPr><w:r><w:rPr><w:color w:val="262626"/><w:sz w:val="19"/><w:szCs w:val="19"/></w:rPr><w:t xml:space="preserve">단순 변심 → A급 재판매 / 포장만 훼손 → 등급 하향 / 기능 불량 → 폐기</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:after="50"/></w:pPr><w:r><w:rPr><w:color w:val="262626"/><w:sz w:val="19"/><w:szCs w:val="19"/></w:rPr><w:t xml:space="preserve">재고가 판매자 소유일 경우, 판매자 동의 절차 후 리퍼브 등록</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="100"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:color w:val="2E74B5"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t xml:space="preserve">②  </w:t></w:r><w:r><w:rPr><w:b/><w:bCs/><w:color w:val="262626"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t xml:space="preserve">재고 누적 감지 에이전트</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="100"/></w:pPr><w:r><w:rPr><w:color w:val="262626"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t xml:space="preserve">특정 상품·카테고리의 반품 재고가 일정 수준 이상 쌓이면 자동으로 알립니다.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="100"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:color w:val="2E74B5"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t xml:space="preserve">③  </w:t></w:r><w:r><w:rPr><w:b/><w:bCs/><w:color w:val="262626"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t xml:space="preserve">리퍼브 기획전 제안 에이전트</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="100"/></w:pPr><w:r><w:rPr><w:color w:val="262626"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t xml:space="preserve">쌓인 재고의 상태와 수량을 바탕으로 리퍼브 할인전 주제, 할인폭, 문구 초안을 제안합니다.</w:t></w:r></w:p><w:sectPr><w:pgSz w:w="11906" w:h="16838" w:orient="portrait"/><w:pgMar w:top="900" w:right="1000" w:bottom="900" w:left="1000" w:header="708" w:footer="708" w:gutter="0"/><w:pgNumType/><w:docGrid w:linePitch="360"/></w:sectPr></w:body></w:document>