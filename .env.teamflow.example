# TeamFlow API 자격정보 — 커밋하지 않는다. .gitignore 대상이다.
# 팀원에게 공유할 때는 값을 비운 .env.teamflow.example 만 올린다.
# 확인일 2026-08-28.

# ── 접속 ─────────────────────────────────────────────────────
TEAMFLOW_BASE_URL=https://jira-for-me.vercel.app

# 우리 팀 프로젝트. GET /api/projects 로 확인한 값이다.
#   43 SKN32_3rd_4team (member) / 84 SKN32_FINAL_TEAM4 (admin) / 85 SKN32_4th_4team (member)
# 프로젝트 이름은 TEAM4 인데 부트캠프 시트의 우리 팀은 6팀이다. 이유는 아직 확인되지 않았다
# (program/plan/A-COP_스프린트_에픽_설계.md "확인하지 못한 것").
TEAMFLOW_PROJECT_ID=84
TEAMFLOW_PROJECT_KEY=ST4F

# ── 토큰 ─────────────────────────────────────────────────────
# 개인 발급 토큰이다. 노출되면 즉시 재발급한다.
TEAMFLOW_API_TOKEN=

# ── 토큰으로 되는 것 ─────────────────────────────────────────
# 두 가지뿐이다. 나머지는 전부 401 "로그인이 필요합니다" 가 돌아온다.
# 관리자 화면의 토큰 권한 스위치와는 무관하다. 서버가 로그인 세션 전용으로 막아둔 경로다.
#
#   GET    /api/projects                        프로젝트 목록
#   POST   /api/issues?projectId=<id>           이슈 생성
#   DELETE /api/issues?projectId=<id>&id=<이슈id>  이슈 삭제
#
#   GET / PATCH / PUT /api/issues       401 — 조회와 수정은 화면에서 한다
#   POST /api/sprints                   401 — 스프린트도 화면에서 만든다
#
# 즉 토큰은 생성과 삭제만 한다. 한 번 만든 이슈는 고칠 수 없으므로,
# 잘못 넣었으면 지우고 다시 만든다. 이때 이슈 키가 바뀐다.

# ── 요청 규칙 ────────────────────────────────────────────────
# projectId 는 본문이 아니라 쿼리스트링으로 보낸다. 본문에 넣으면 "projectId가 필요합니다".
# DELETE 의 id 도 같다. 본문에 넣으면 "이슈 ID가 필요합니다".
# /api/issues/<id> 같은 개별 경로는 없다(404). 전부 /api/issues + 쿼리스트링이다.
#
# 본문 필드
#   title     제목
#   desc      설명. description 이 아니다. 이름이 틀리면 조용히 무시되고 빈 값이 저장된다
#   type      epic | task 등 소문자. EPIC 으로 보내면 무시되고 task 가 된다
#   priority  high | medium | low 소문자. 위와 같다
#
# 한글 본문은 반드시 파일로 보낸다. Windows Git Bash 에서 curl -d '...' 로 인라인 전달하면
# 인자가 콘솔 코드페이지로 변환되면서 글자가 깨진다. --data-binary @파일 을 쓴다.

# ── 예시 ─────────────────────────────────────────────────────
#   set -a; . ./.env.teamflow; set +a
#
#   cat > issue.json <<'JSON'
#   {"title":"E01 케이스 생명주기와 상태 전이","desc":"담당: 코어 1 / 목표 스프린트: S1","type":"epic","priority":"high"}
#   JSON
#
#   curl -s -X POST "$TEAMFLOW_BASE_URL/api/issues?projectId=$TEAMFLOW_PROJECT_ID" \
#     -H "Authorization: Bearer $TEAMFLOW_API_TOKEN" \
#     -H "Content-Type: application/json; charset=utf-8" \
#     --data-binary @issue.json

# 삭제 예)
#   curl -s -X DELETE "$TEAMFLOW_BASE_URL/api/issues?projectId=$TEAMFLOW_PROJECT_ID&id=<이슈id>" #     -H "Authorization: Bearer $TEAMFLOW_API_TOKEN"
#   → {"ok":true}
