eval/reports/pairs*.jsonl

# 지식 원문 중 외부 저작물이 섞이면 여기로 (현재 corpus 는 자체 작성분이라 커밋한다)
knowledge/raw/

# 로컬 DB 덤프
*.dump
*.sqlite3

# OS
Thumbs.db
.DS_Store

# 빌드·휠 검사 찌꺼기 (저장소에 쌓지 않는다)
.wheelhouse*/
build/
dist/
*.egg-info/

# 런타임 데이터 (Composer audit JSONL 등) — 소스가 아니다, 커밋하지 않는다
var/

# Composer apply_candidate() 가 매 쓰기마다 남기는 직전 상태 백업
*.yaml.bak
