{
  "manifest_version": 3,
  "name": "쿠팡 주문내역 추출",
  "version": "1.0.0",
  "description": "로그인된 쿠팡 주문목록에서 주문 정보를 로컬 JSON 파일로 저장합니다.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://mc.coupang.com/*",
    "https://www.coupang.com/*"
  ],
  "action": {
    "default_title": "쿠팡 주문내역 추출",
    "default_popup": "popup.html"
  }
}
