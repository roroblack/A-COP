{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://a-cop.local/schemas/naver_order_history/order_schema.json",
  "title": "A-COP normalized Naver order",
  "description": "네이버 주문 이력 원본을 Commerce Ops Pack용으로 정규화한 주문 1건",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "order_id",
    "order_status",
    "seller_name",
    "product",
    "payment",
    "shipping",
    "cs",
    "_source"
  ],
  "properties": {
    "order_id": {
      "type": "string",
      "minLength": 1
    },
    "order_status": {
      "type": ["string", "null"]
    },
    "seller_name": {
      "type": ["string", "null"]
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "option", "quantity", "unit_price", "total_price"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "option": {
          "type": ["string", "null"]
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        },
        "unit_price": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "total_price": {
          "type": ["number", "null"],
          "minimum": 0
        }
      }
    },
    "payment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "method", "status", "paid_at"],
      "properties": {
        "amount": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "method": {
          "type": ["string", "null"]
        },
        "status": {
          "type": ["string", "null"]
        },
        "paid_at": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    },
    "shipping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "carrier",
        "tracking_number",
        "status",
        "region",
        "fee",
        "completed_at",
        "events",
        "exception"
      ],
      "properties": {
        "carrier": {
          "type": ["string", "null"]
        },
        "tracking_number": {
          "type": ["string", "null"]
        },
        "status": {
          "type": ["string", "null"]
        },
        "region": {
          "type": ["string", "null"]
        },
        "fee": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "completed_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "where", "timeString"],
            "properties": {
              "kind": {
                "type": ["string", "null"]
              },
              "where": {
                "type": ["string", "null"]
              },
              "timeString": {
                "type": ["string", "null"]
              }
            }
          }
        },
        "exception": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "detail", "occurred_at"],
          "properties": {
            "code": {
              "type": ["string", "null"]
            },
            "detail": {
              "type": ["string", "null"]
            },
            "occurred_at": {
              "type": ["string", "null"],
              "format": "date-time"
            }
          }
        }
      }
    },
    "cs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "has_inquiry",
        "return_status",
        "return_eligible",
        "return_reason_code",
        "purchase_confirmed_at",
        "return_deadline_at",
        "refund"
      ],
      "properties": {
        "has_inquiry": {
          "type": "boolean"
        },
        "return_status": {
          "type": ["string", "null"]
        },
        "return_eligible": {
          "type": ["boolean", "null"]
        },
        "return_reason_code": {
          "type": ["string", "null"]
        },
        "purchase_confirmed_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "return_deadline_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "refund": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "gross_amount", "deduction_amount", "refundable_amount", "calculated_at"],
          "properties": {
            "status": {
              "type": ["string", "null"]
            },
            "gross_amount": {
              "type": ["number", "null"],
              "minimum": 0
            },
            "deduction_amount": {
              "type": ["number", "null"],
              "minimum": 0
            },
            "refundable_amount": {
              "type": ["number", "null"],
              "minimum": 0
            },
            "calculated_at": {
              "type": ["string", "null"],
              "format": "date-time"
            }
          }
        }
      }
    },
    "_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["crawled_at", "raw_ref", "pii_hashes", "normalization_warnings"],
      "properties": {
        "crawled_at": {
          "type": "string",
          "format": "date-time"
        },
        "raw_ref": {
          "type": "string",
          "minLength": 1
        },
        "pii_hashes": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "normalization_warnings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
