or; border-image: none; border-radius: 0px; flex: 1 1 0%; min-width: 0px; m=
ax-width: 100%; font-size: 14px; overflow: hidden; }

.Rx43rG_codemirror .cm-scroller { scroll-behavior: auto; overscroll-behavio=
r-x: contain; scrollbar-color: var(--scrollbar-color) transparent; min-widt=
h: 0px; overflow-x: auto; }

.Rx43rG_codemirror .cm-scroller:hover { scrollbar-color: var(--scrollbar-co=
lor-hover) transparent; }

.Rx43rG_codemirror .cm-scroller::-webkit-scrollbar-track, .Rx43rG_codemirro=
r .cm-scroller::-webkit-scrollbar-corner { background: 0px 0px; }

.Rx43rG_codemirror .cm-focused { outline: none; }

.Rx43rG_codemirror .cm-content { padding: 0 calc(var(--spacing) * 2.5) calc=
(var(--spacing) * 3); line-height: 20px; font-family: var(--font-mono) !imp=
ortant; }

@media (min-width: 768px) {
  .Rx43rG_codemirror .cm-content { padding: 0 calc(var(--spacing) * 3.5) ca=
